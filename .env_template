# ╔══════════════════════════════════════════════════════════╗
# ║          DIGITAL WORLD — API KEYS CONFIGURATION          ║
# ║                                                          ║
# ║  1. Copy this file: cp .env_template .env               ║
# ║  2. Fill in your keys below                             ║
# ║  3. Never commit .env to git                            ║
# ╚══════════════════════════════════════════════════════════╝

# ── MAIN WORLD AI (Yggdrasil) ────────────────────────────────
# This is the model that names Digimon, writes descriptions,
# and handles all the non-MAGI LLM calls.
# Set this to whichever API you want as the main one.
#
# Options: "openai" | "deepseek" | "gemini" | "qwen"
LLM_PROVIDER=ollama
KB_MAX_ENTRIES=150

# ── MAGI COUNCIL ────────────────────────────────────────────
# Three different AI minds. Each uses a different provider.
# This is what makes them genuinely reason differently.
#
# SOLOMON — Data seat — ChatGPT (wise, analytical)
# Your OpenAI key goes here. Already set above via LLM_API_KEY
# so you don't need to set it again unless you want a different key.
MAGI_SOLOMON_PROVIDER=ollama
MAGI_SOLOMON_MODEL=llama3.2:3b

# SALADIN — Virus seat — Ollama (local, no token limits)
MAGI_SALADIN_PROVIDER=ollama
MAGI_SALADIN_MODEL=qwen2.5:3b

# AL-FATIH — Vaccine seat — Ollama (local, no token limits)
MAGI_ALFATIH_PROVIDER=ollama
MAGI_ALFATIH_MODEL=gemma2:2b

# ── MAGI ENCRYPTED MEMORY ───────────────────────────────────
# A passphrase that encrypts the MAGI memory files.
# Choose something strong. Write it down somewhere safe.
# Lose it = memory files are permanently unreadable.
# Share it with Claude when you want memory inspection.
MAGI_PASSPHRASE=

# ── BIOME DATA FEEDS ────────────────────────────────────────
# These feed real-world data into the biomes.
# The world runs without them but biomes will be static.

# Desert biome — threat intelligence
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Highlands biome — security advisories
NIST_API_KEY=

# Grasslands biome — news
NEWSAPI_KEY=

# Mountains + DeepOcean — tech and AI research
GITHUB_TOKEN=
NVIDIA_API_KEY=

# Ocean biome — space and science
# DEMO_KEY works but has rate limits. Free key at api.nasa.gov
NASA_API_KEY=

# Art/Knowledge biome — CC0 creative resources
# Free key at: freesound.org/apiv2/apply
FREESOUND_API_KEY=

# ── WORLD SETTINGS ───────────────────────────────────────────
# Uncomment to override defaults from config.py

# WORLD_ID=VM_A
# TICK_SLEEP=0.5
# INITIAL_POP=30
# ASCENSION_THRESHOLD=1000
# NETWORK_ENABLED=true
# VM_PORT=8765

# ── ADMIN CHANNEL ────────────────────────────────────────────
# Must be the same value on ALL VMs if running multi-VM.
# Change this before running on a real network.
ADMIN_SECRET=change-this-before-running-on-a-real-network

